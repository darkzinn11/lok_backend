# Configurações Gerais
APP_ENV=production
HOST=127.0.0.1
PORT=8081

# Banco de Dados (Use DATABASE_URL ou as variáveis separadas)
# DATABASE_URL=postgresql://lokcenter_user:SENHA@127.0.0.1:5432/lokcenter_db?sslmode=disable
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=lokcenter_user
DB_PASSWORD=SUBSTITUIR_PELA_SENHA_REAL
DB_NAME=lokcenter_db
DB_SSLMODE=disable

# Segurança
JWT_SECRET=GERAR_UM_SEGREDO_ALFANUMERICO_LONGO_E_SEGURO
CORS_ALLOWED_ORIGINS=https://lokcenter.syvo.cloud

# Storage e Logs
UPLOAD_DIR=/srv/apps/lokcenter/uploads
LOG_DIR=/srv/apps/lokcenter/logs

# JWT TTL
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
